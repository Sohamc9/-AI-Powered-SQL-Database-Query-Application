# QueryPilot Environment Configuration

# Server Port
PORT=3001

# AI Provider Configuration (Optional)
# Leave blank to use QueryPilot's smart built-in Demo Assistant (offline, no API key required)
# Supported real providers: "openai" or "gemini"
AI_PROVIDER=demo

# OpenAI API Key (Optional) - Used if AI_PROVIDER=openai
OPENAI_API_KEY=

# OpenAI Model (Optional, defaults to gpt-4o-mini)
OPENAI_MODEL=gpt-4o-mini

# Google Gemini API Key (Optional) - Used if AI_PROVIDER=gemini
GEMINI_API_KEY=

# Database Configuration (Optional)
# Default is "sqlite-demo" which uses seeded in-memory SQLite
DATABASE_MODE=sqlite-demo

# Optional Custom Database Connection String (for future adapters, e.g. postgres/mysql)
# DATABASE_URL=postgresql://user:password@localhost:5432/mydb
